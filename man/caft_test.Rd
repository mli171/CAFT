est <- caft_estimate(
  otu.table = count.tab,
  x = x,
  regularize = TRUE,
  n.cores = 1L
)

res <- caft_test(est, Gamma = Gamma, b = c(0, 0))
print(res)

## Equivalent interface: construct Gamma internally from x.test/x.adj.
